      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET\n  nome        = COALESCE(NULLIF(trim($3), ''), nome),\n  email       = COALESCE(CASE WHEN $4 ~ '^\\S+@\\S+\\.\\S+$' THEN lower(trim($4)) END, email),\n  area        = COALESCE(NULLIF(lower(trim($5)), ''), area),\n  resumo_caso = COALESCE(NULLIF(trim($6), ''), resumo_caso),\n  urgencia    = COALESCE(CASE WHEN lower($7) IN ('baixa','media','média','alta') THEN replace(lower($7), 'é', 'e') END, urgencia),\n  ja_e_cliente = ja_e_cliente OR lower($8) IN ('sim','true','s'),\n  consentimento_lgpd_em = COALESCE(consentimento_lgpd_em, CASE WHEN lower($9) IN ('sim','true','s') THEN now() END),\n  atualizado_em = now()\nWHERE id = $2::uuid AND escritorio_id = $1::uuid\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.escritorio_id, $json.lead_id, $json.nome ?? '', $json.email ?? '', $json.area ?? '', $json.resumo_caso ?? '', $json.urgencia ?? '', $json.ja_e_cliente ?? '', $json.consentimento_lgpd ?? ''] }}"
        }
      },
      "id": "7148807c-6649-54ba-bec6-c6721227ceb9",
      "name": "Atualizar cadastro",
      "type": "n8n-nodes-base.postgres",
