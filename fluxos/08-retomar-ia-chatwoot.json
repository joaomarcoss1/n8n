          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.body.event }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "conversation_status_changed"
            },
            {
              "id": "c1",
              "leftValue": "={{ $json.body.status }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "resolved"
