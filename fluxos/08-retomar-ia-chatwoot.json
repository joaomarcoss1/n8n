      "id": "63a9c998-7afc-576f-ae14-9285a18e6003",
      "name": "Conversa resolvida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH l AS (\n  UPDATE leads l SET ia_pausada_ate = NULL,\n         status = CASE WHEN l.status = 'humano' THEN 'em_triagem' ELSE l.status END, atualizado_em = now()\n  FROM escritorios e\n  WHERE e.id = l.escritorio_id AND e.chatwoot_inbox_id = $1::int AND l.whatsapp = $2\n  RETURNING l.id)\nUPDATE encaminhamentos SET resolvido_em = now()\nWHERE lead_id IN (SELECT id FROM l) AND resolvido_em IS NULL\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.body.inbox_id, String($json.body.meta?.sender?.phone_number ?? '').replace(/\\D/g, '')] }}"
        }
      },
      "id": "1111b235-8128-543e-aa2e-b0b4c2b9e4d3",
      "name": "Reativar IA",
      "type": "n8n-nodes-base.postgres",
