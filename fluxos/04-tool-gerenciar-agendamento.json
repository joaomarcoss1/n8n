        "jsCode": "const TZ = 'America/Sao_Paulo';\nconst fmtFone = (n) => { const d = String(n || '').replace(/\\D/g, ''); if (d.length >= 12 && d.startsWith('55')) { const r = d.slice(2); return `+55 (${r.slice(0,2)}) ${r.slice(2, r.length-4)}-${r.slice(-4)}`; } return '+' + d; };\nconst fmtData = (iso) => DateTime.fromISO(String(iso), { zone: TZ }).setZone(TZ).setLocale('pt-BR').toFormat(\"cccc, dd/MM/yyyy 'às' HH:mm\");\n\nconst d = $('Reunião do cliente').first().json;\nreturn [{ json: { resposta: `Presença CONFIRMADA na reunião de ${fmtData(d.inicio)} com ${d.responsavel?.nome || 'a equipe'}. Agradeça ao cliente.` } }];"
