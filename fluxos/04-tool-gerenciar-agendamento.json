    {
      "parameters": {
        "jsCode": "const TZ = 'America/Sao_Paulo';\nconst fmtFone = (n) => { const d = String(n || '').replace(/\\D/g, ''); if (d.length >= 12 && d.startsWith('55')) { const r = d.slice(2); return `+55 (${r.slice(0,2)}) ${r.slice(2, r.length-4)}-${r.slice(-4)}`; } return '+' + d; };\nconst fmtData = (iso) => DateTime.fromISO(String(iso), { zone: TZ }).setZone(TZ).setLocale('pt-BR').toFormat(\"cccc, dd/MM/yyyy 'às' HH:mm\");\n\nconst d = $('Reunião do cliente').first().json;\nconst remarcou = $('Chamado pela IA').first().json.acao.toLowerCase().trim() === 'remarcar';\nconst novo = remarcou ? $('Agendar novo horário').first().json.resposta : '';\nreturn [{ json: {\n  instancia: d.instancia_whatsapp, numero: d.responsavel?.whatsapp,\n  texto: `${remarcou ? '🔁 *Reunião remarcada*' : '❌ *Reunião cancelada pelo cliente*'}\\n\\n*Cliente:* ${d.nome_cliente} (wa.me/${d.whatsapp})\\n*${remarcou ? 'Horário antigo' : 'Horário'}:* ${fmtData(d.inicio)}${remarcou ? '\\n_O novo horário foi enviado em outra mensagem._' : ''}`,\n  resposta: remarcou\n    ? novo.replace('Reunião AGENDADA', 'Reunião REMARCADA') + ` O horário antigo (${fmtData(d.inicio)}) foi cancelado.`\n    : `Reunião de ${fmtData(d.inicio)} CANCELADA. Confirme ao cliente e pergunte se deseja agendar outro horário.`,\n}}];"
      },
