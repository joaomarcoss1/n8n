    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Só enxerga reuniões DESTE cliente: a IA não consegue mexer na agenda de outra pessoa.\nSELECT a.*, to_jsonb(r) AS responsavel, e.instancia_whatsapp, e.endereco, e.duracao_reuniao_min,\n       COALESCE(l.nome, l.nome_whatsapp) AS nome_cliente, l.whatsapp,\n       (SELECT count(*) FROM agendamentos x WHERE x.lead_id = l.id AND x.status IN ('marcado','confirmado') AND x.inicio > now()) AS total_futuras,\n       (SELECT jsonb_agg(jsonb_build_object('id', x.id, 'inicio', x.inicio, 'modalidade', x.modalidade, 'status', x.status) ORDER BY x.inicio)\n          FROM agendamentos x WHERE x.lead_id = l.id AND x.status IN ('marcado','confirmado') AND x.inicio > now()) AS futuras\nFROM leads l\nJOIN escritorios e ON e.id = l.escritorio_id\nLEFT JOIN LATERAL (\n  SELECT * FROM agendamentos a\n  WHERE a.lead_id = l.id AND a.status IN ('marcado','confirmado') AND a.inicio > now()\n    AND (NULLIF($3, '') IS NULL OR a.id::text = $3)\n  ORDER BY a.inicio LIMIT 1) a ON true\nLEFT JOIN responsaveis r ON r.id = a.responsavel_id\nWHERE l.id = $2::uuid AND l.escritorio_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.escritorio_id, $json.lead_id, $json.agendamento_id ?? ''] }}"
        }
      },
