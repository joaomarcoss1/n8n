# Copie para .env (o install.sh faz isso e gera as senhas sozinho).

# Seu domínio. Crie 4 registros DNS tipo A apontando para o IP do VPS:
#   painel.seudominio.com.br, n8n.seudominio.com.br, api.seudominio.com.br, chat.seudominio.com.br
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br
N8N_SUBDOMAIN=n8n
EVOLUTION_SUBDOMAIN=api
CHATWOOT_SUBDOMAIN=chat
PAINEL_SUBDOMAIN=painel
TZ=America/Sao_Paulo

# Banco e cache (gerados automaticamente pelo install.sh)
POSTGRES_USER=assistente
POSTGRES_PASSWORD=troque-me
REDIS_PASSWORD=troque-me

# Segredos (gerados automaticamente pelo install.sh). Guarde o N8N_ENCRYPTION_KEY:
# sem ele as credenciais salvas no n8n não podem ser lidas.
N8N_ENCRYPTION_KEY=troque-me
EVOLUTION_API_KEY=troque-me
CHATWOOT_SECRET_KEY_BASE=troque-me
PAINEL_DB_PASSWORD=troque-me
PAINEL_N8N_SECRET=troque-me

# Inteligência artificial ----------------------------------------------------
# Chave da Anthropic (Claude): https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Opcional: transcrição de áudios do WhatsApp (OpenAI Whisper): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Agenda (opcional) - OAuth Client do Google Cloud (tipo "Aplicativo da Web")
# URI de redirecionamento: https://n8n.SEUDOMINIO/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp que recebe alertas de erro dos fluxos (só números, com DDI). Ex.: 5511999990000
ADMIN_WHATSAPP=

# Versões das imagens. Em produção, fixe versões testadas em vez de "latest".
N8N_IMAGE_TAG=latest
EVOLUTION_IMAGE_TAG=latest
CHATWOOT_IMAGE_TAG=latest
POSTGRES_IMAGE_TAG=pg17
REDIS_IMAGE_TAG=7-alpine
CADDY_IMAGE_TAG=2-alpine
